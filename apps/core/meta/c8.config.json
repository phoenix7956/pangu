{
  "all": true,
  "include": ["pangu-single.js", "modules/**/*.js", "64i/**/*.js", "modules/**/*.cjs", "modules/**/*.mjs"],
  "exclude": [
    "tests/**",
    "node_modules/**",
    "**/*.bak",
    "**/*.tmp",
    "docs/**",
    "scripts/**",
    "coverage/**"
